<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product
      Id="*"
      Name="Ferric"
      Language="1033"
      Version="$(var.AppVersion)"
      Manufacturer="Raflyf"
      UpgradeCode="A4C8E71F-92B4-4D3E-8E6A-3B5F90C1D427">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perUser"
        Platform="x64"
        Description="Ferric $(var.AppVersion) Setup"
        Comments="Ferric - Hi-Fi Desktop Music Player" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FerricIcon.ico" SourceFile="$(var.RepoRoot)\assets\brand\ferric.ico" />
    <Property Id="ARPPRODUCTICON" Value="FerricIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Raflyf/Ferric" />
    <Property Id="ARPNOREPAIR" Value="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Ferric" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WixShellExecTarget" Value="[#FerricExe]" />

    <util:CloseApplication
        Id="CloseFerric"
        Target="ferric.exe"
        CloseMessage="yes"
        EndSessionMessage="yes"
        PromptToContinue="no"
        RebootPrompt="no"
        Timeout="3" />

    <!-- Auto-close any running or tray-minimized Ferric instance (and WebView2 children)
         BEFORE InstallValidate so Windows Installer never shows "Files in Use" or leaves locked files. -->
    <CustomAction
        Id="SetForceCloseFerricCmd"
        Property="ForceCloseFerric"
        Value="&quot;[System64Folder]cmd.exe&quot; /d /c &quot;taskkill /F /T /IM ferric.exe &gt;nul 2&gt;&amp;1 &amp;&amp; ping -n 2 127.0.0.1 &gt;nul&quot;" />
    <CustomAction
        Id="ForceCloseFerric"
        BinaryKey="WixCA"
        DllEntry="WixQuietExec64"
        Execute="immediate"
        Impersonate="yes"
        Return="ignore" />

    <CustomAction
        Id="LaunchApplication"
        BinaryKey="WixCA"
        DllEntry="WixShellExec"
        Impersonate="yes" />

    <!-- Clean Uninstall: wipe all Ferric caches, logs, WebView2/Spotify profiles, temp dirs,
         updates & SQLite DB strictly on full Uninstall (NEVER during in-place MSI upgrade).
         Removes parent %LOCALAPPDATA%\LivelyDesk only when empty so sibling LivelyDesk apps stay untouched. -->
    <CustomAction
        Id="SetCleanUninstallCmd"
        Property="CleanUninstallUserData"
        Value="&quot;[System64Folder]cmd.exe&quot; /d /c &quot;taskkill /F /T /IM ferric.exe &gt;nul 2&gt;&amp;1 &amp; if exist &quot;%LOCALAPPDATA%\LivelyDesk\Ferric&quot; rd /s /q &quot;%LOCALAPPDATA%\LivelyDesk\Ferric&quot; &amp; rd &quot;%LOCALAPPDATA%\LivelyDesk&quot; 2&gt;nul &amp; if exist &quot;%APPDATA%\LivelyDesk\Ferric&quot; rd /s /q &quot;%APPDATA%\LivelyDesk\Ferric&quot; &amp; rd &quot;%APPDATA%\LivelyDesk&quot; 2&gt;nul &amp; if exist &quot;[INSTALLFOLDER]&quot; rd /s /q &quot;[INSTALLFOLDER]&quot; &amp; if exist &quot;%LOCALAPPDATA%\Programs\Ferric&quot; rd /s /q &quot;%LOCALAPPDATA%\Programs\Ferric&quot; &amp; if exist &quot;%TEMP%\ferric_spotify_capture.txt&quot; del /f /q &quot;%TEMP%\ferric_spotify_capture.txt&quot; &amp; for /d %D in (&quot;%TEMP%\ferric-spotify-browser-*&quot;) do rd /s /q &quot;%D&quot;&quot;" />
    <CustomAction
        Id="CleanUninstallUserData"
        BinaryKey="WixCA"
        DllEntry="WixQuietExec64"
        Execute="deferred"
        Impersonate="yes"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetForceCloseFerricCmd" Before="ForceCloseFerric" />
      <Custom Action="ForceCloseFerric" Before="InstallValidate" />
      <Custom Action="SetCleanUninstallCmd" Before="CleanUninstallUserData">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CleanUninstallUserData" After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.RepoRoot)\assets\brand\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.RepoRoot)\assets\brand\wix-dialog.bmp" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Ferric" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppMainComp" Guid="D71F48B2-6C09-4A1E-B523-9F42E10C83A5" Win64="yes">
        <RegistryValue
            Root="HKCU"
            Key="Software\Raflyf\Ferric\Install"
            Name="InstallPath"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <RegistryKey Root="HKCU" Key="Software\Raflyf\Ferric" ForceDeleteOnUninstall="yes" />
        <RegistryKey Root="HKCU" Key="Software\Classes\AppUserModelId\Raflyf.Ferric" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="DisplayName" Type="string" Value="Ferric" />
          <RegistryValue Name="IconUri" Type="string" Value="[#FerricIconFile]" />
        </RegistryKey>
        <File Id="FerricExe" Source="$(var.AppExe)" />
        <File Id="ReadmeMd" Source="$(var.RepoRoot)\README.md" />
        <File Id="LicenseTxt" Source="$(var.RepoRoot)\LICENSE" />
        <File Id="ChangelogMd" Source="$(var.RepoRoot)\CHANGELOG.md" />
        <File Id="FerricIconFile" Source="$(var.RepoRoot)\assets\brand\ferric.ico" />
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="Ferric"
            Description="Ferric"
            Target="[#FerricExe]"
            WorkingDirectory="INSTALLFOLDER"
            Icon="FerricIcon.ico"
            Advertise="no">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Raflyf.Ferric" />
        </Shortcut>
        <RemoveFolder Id="RemoveProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Ferric" Level="1">
      <ComponentRef Id="AppMainComp" />
      <ComponentGroupRef Id="MakepadResourcesGroup" />
    </Feature>
  </Product>
</Wix>
